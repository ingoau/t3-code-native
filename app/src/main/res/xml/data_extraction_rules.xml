<?xml version="1.0" encoding="utf-8"?>
<!-- Paired environments hold tokens encrypted with a device-bound Keystore key, which can't be restored elsewhere. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/environments.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/environments.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
